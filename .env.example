# ===========================================
# Stream Engine - Environment Variables
# Copy to .env and fill in your values
# ===========================================

# -------------------------------------------
# REQUIRED - Google OAuth (Desktop App Type)
# -------------------------------------------
# Create at: https://console.cloud.google.com/apis/credentials
# Application type: Desktop app
# Authorized redirect URIs: http://localhost:3000/api/auth/youtube/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback

# -------------------------------------------
# REQUIRED - Encryption Master Key
# -------------------------------------------
# Generate with: openssl rand -base64 32
# Must be exactly 32 bytes (44 chars base64)
MASTER_KEY=your-base64-encoded-32-byte-key-here

# -------------------------------------------
# OPTIONAL - Server
# -------------------------------------------
NODE_ENV=development
PORT=3000

# -------------------------------------------
# OPTIONAL - Database (SQLite)
# -------------------------------------------
DATABASE_URL=file:./data/db.sqlite

# -------------------------------------------
# OPTIONAL - Redis (BullMQ + Socket.io)
# -------------------------------------------
REDIS_URL=redis://localhost:6379

# -------------------------------------------
# OPTIONAL - RTMP Server (Node-Media-Server)
# -------------------------------------------
RTMP_PORT=1935
HTTP_FLV_PORT=8000

# -------------------------------------------
# OPTIONAL - FFmpeg Hardware Acceleration
# -------------------------------------------
# auto = detect at startup (nvenc > qsv > videotoolbox > amf > cpu)
# nvenc = NVIDIA NVENC (requires GPU + drivers)
# qsv = Intel Quick Sync (requires Intel GPU + media-driver)
# videotoolbox = Apple VideoToolbox (macOS)
# amf = AMD AMF (requires AMD GPU + ROCm)
# none = Software encoding (libx264)
FFMPEG_HWACCEL=auto

# NVENC preset: p1 (fastest) to p7 (best quality), p4 = balanced
FFMPEG_NVENC_PRESET=p4

# Maximum concurrent FFmpeg processes
MAX_CONCURRENT_STREAMS=3

# -------------------------------------------
# OPTIONAL - Logging
# -------------------------------------------
LOG_LEVEL=info
LOG_DIR=./logs

# -------------------------------------------
# OPTIONAL - Monitoring (Prometheus)
# -------------------------------------------
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# -------------------------------------------
# OPTIONAL - Grafana
# -------------------------------------------
GRAFANA_PASSWORD=admin