{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "baseUrl": ".",
    "paths": {
      "@stream-engine/shared/*": ["node_modules/@stream-engine/shared/dist/*"],
      "@stream-engine/server/*": ["packages/server/src/*"],
      "@stream-engine/client/*": ["packages/client/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "**/dist/**"]
}