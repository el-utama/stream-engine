{
  "name": "stream-engine",
  "version": "1.0.0",
  "description": "Smart YouTube Streaming Engine - Lightweight, multi-account, multi-platform",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter=server dev & pnpm --filter=client dev",
    "build": "pnpm -r run build",
    "build:server": "pnpm --filter=server build",
    "build:client": "pnpm --filter=client build",
    "start": "pnpm --filter=server start",
    "db:generate": "pnpm --filter=server db:generate",
    "db:push": "pnpm --filter=server db:push",
    "db:studio": "pnpm --filter=server db:studio",
    "db:seed": "pnpm --filter=server db:seed",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "typescript": "^5.4.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "vitest": "^1.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}